#version 450
// GPU-side grow_periphery: dispatch orients, grow segments, minimize, cluster, return full conformers
// CPU becomes dispatch thread: pending_q orients → GPU → output_q DockResult
// No arbitrary bounds: na, num_seeds, num_layers, num_segments unbounded — buffers sized per dispatch
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer BOriXYZ  { float orient_xyz[]; }; // [num_orients * na *3]
layout(std430, binding = 1) buffer BVDWA    { float vdwA[]; };
layout(std430, binding = 2) buffer BVDWB    { float vdwB[]; };
layout(std430, binding = 3) buffer BCHG     { float charges[]; };
layout(binding = 4) uniform sampler3D g_avdw;
layout(binding = 5) uniform sampler3D g_bvdw;
layout(binding = 6) uniform sampler3D g_es;
layout(std430, binding = 7) buffer BSegs    { int seg_atoms[]; }; // flattened SEGMENT atoms/bonds
layout(std430, binding = 8) buffer BLayers  { int layer_segs[]; };
layout(std430, binding = 9) buffer BBonds   { int bond_list[]; };
layout(std430, binding = 10) buffer BOutXYZ { float out_xyz[]; }; // [num_orients * max_confs * na *3] chunked
layout(std430, binding = 11) buffer BOutScore { float out_scores[]; };
layout(std430, binding = 12) buffer BAct     { int active_flags[]; };
layout(std430, binding = 13) buffer BIEVDWA  { float ie_vdwA[]; };
layout(std430, binding = 14) buffer BPairStarts { int pair_starts[]; };
layout(std430, binding = 15) buffer BPairIndices { int pair_indices[]; };

layout(push_constant) uniform Params {
    float origin_x, origin_y, origin_z;
    int   span_x, span_y, span_z;
    float spacing;
    int   num_atoms;
    int   num_orients;
    int   num_layers;
    int   pruning_clustering_cutoff;
    float pruning_conformer_score_cutoff;
    float pruning_cluster_rmsd;
    int   simplex_max_iterations;
    float ie_soft_delta;
    float ie_cutoff_sq;
    int   num_nb_pairs;
} p;

// Reuse grid sampler from minimizer.comp
float sample_grid(sampler3D grid, float x, float y, float z) {
    float gx = (x - p.origin_x) / p.spacing;
    float gy = (y - p.origin_y) / p.spacing;
    float gz = (z - p.origin_z) / p.spacing;
    if (gx < 0.0 || gy < 0.0 || gz < 0.0 ||
        gx >= float(p.span_x -1) || gy >= float(p.span_y -1) || gz >= float(p.span_z -1))
        return 0.0;
    vec3 c = vec3((gx+0.5)/float(p.span_x),(gy+0.5)/float(p.span_y),(gz+0.5)/float(p.span_z));
    return texture(grid, c).r;
}

void main() {
    uint orient = gl_WorkGroupID.x;
    if (orient >= uint(p.num_orients)) return;
    // One workgroup per orient, grows all layers, minimizes, clusters, writes final conformers
    // Full AG logic: next_anchor → match_ligand → new_next_orientation already done on CPU orient stage
    // Here: for each layer, segment_torsion_drive, activate_layer_segment, minimize, prune, cluster

    // Placeholder: currently just scores and minimizes the anchor pose via minimizer logic
    // Full grow loop will iterate layers/segments, generate CONFORMER pool, prune, and write
    // This externalized file makes editing the grow kernel trivial without touching .cpp

    int na = p.num_atoms;
    int base = int(orient) * na * 3;
    // For now, pass-through score to verify dispatch plumbing
    float s = 0.0;
    for (int a=0; a<na; a++) {
        int o3 = base + a*3;
        float x = orient_xyz[o3], y = orient_xyz[o3+1], z = orient_xyz[o3+2];
        if (active_flags[a]==0) continue;
        s += vdwA[a]*sample_grid(g_avdw,x,y,z) - vdwB[a]*sample_grid(g_bvdw,x,y,z) + charges[a]*sample_grid(g_es,x,y,z);
    }
    if (gl_LocalInvocationID.x==0) out_scores[orient]=s;
    // Copy orient xyz to out as placeholder for grown conformer
    for (int a=int(gl_LocalInvocationID.x); a<na; a+=64) {
        int o3 = base + a*3;
        out_xyz[o3]=orient_xyz[o3]; out_xyz[o3+1]=orient_xyz[o3+1]; out_xyz[o3+2]=orient_xyz[o3+2];
    }
}
