#version 450
// anchor_grow.comp — SINGLE GPU DISPATCH PER ANCHOR (full growth loop)
// One workgroup per orient. Thread 0 grows that orient through ALL layers:
//   anchor minimize → loop bonds in growth order →
//   sample DB dihedrals → relative-DOF simplex minimize → prune by score →
//   keep best KEEP per WG → atomic-append survivors to out.
// Mirrors CPU grow_periphery: each (layer,segment) drives its rotatable bond
// with the amber_bt_torsions angle list; scoring sums only ACTIVE atoms up to
// that growth stage; the simplex perturbs 6+{grown torsions} DOF relative to
// the current pose (the CPU minimizer perturbs around the pose too).

layout(local_size_x = 64) in;

#define MAXDB 32
#define SLOTS 64    // 0=ws, 1=pristine, 2..63=frontier (no KEEP limit - retain all)

layout(std430, binding = 0) buffer BOrientXYZ { float orient_xyz[]; }; // [N*na*3] all orients for this anchor
layout(std430, binding = 1) buffer BRefXYZ    { float ref_xyz[]; };    // [na*3] anchor ref (unused placeholder)
layout(std430, binding = 2) buffer BVDWA      { float vdwA[]; };
layout(std430, binding = 3) buffer BVDWB      { float vdwB[]; };
layout(std430, binding = 4) buffer BCHG       { float charges[]; };
layout(binding = 5) uniform sampler3D g_avdw;
layout(binding = 6) uniform sampler3D g_bvdw;
layout(binding = 7) uniform sampler3D g_es;
layout(std430, binding = 8) buffer BOutXYZ   { float out_xyz[]; };    // [max_out*na*3]
layout(std430, binding = 9) buffer BOutScore { float out_scores[]; };
layout(std430, binding = 10) buffer BCounter  { uint out_counter[]; }; // atomic
layout(std430, binding = 11) buffer BAct      { int active_flags[]; }; // unused by grow loop
layout(std430, binding = 12) buffer BIEVDWA   { float ie_vdwA[]; };
layout(std430, binding = 13) buffer BPairStarts { int pair_starts[]; };
layout(std430, binding = 14) buffer BPairIdx  { int pair_indices[]; };
layout(std430, binding = 15) buffer BTors     { int tors_a1234[]; };  // [T*5]: a1,a2,a3,a4,nang
layout(std430, binding = 16) buffer BTorsMask { int tors_mask[]; };   // [T*na]
layout(std430, binding = 17) buffer BScratch  { float scratch[]; };   // [N*SLOTS*na*3]
layout(std430, binding = 18) buffer BAngles   { float ang_db[]; };    // [T*MAXDB] degrees
layout(std430, binding = 19) buffer BActSet   { int actset[]; };      // [(ntors+1)*na]

/* Nelder-Mead working set, one SIMPLEX_VSTRIDE-float region per invocation.
   This deliberately lives in a storage buffer rather than private arrays:
   p[33][32] and friends were 5.2 KB of dynamically-indexed per-invocation
   storage, which makes some drivers (RADV's LLVM backend in particular)
   take pathologically long to compile. In an SSBO the private footprint is
   constant regardless of the DOF count, so no per-driver tuning is needed. */
#define SIMPLEX_VSTRIDE 1249
layout(std430, binding = 20) buffer BSimplex  { float simp[]; };

layout(push_constant) uniform PC {
    float origin_x, origin_y, origin_z;
    int   span_x, span_y, span_z;
    float spacing;
    int   num_atoms;
    int   num_orients;          // N for this anchor
    int   num_tors;
    int   num_layers;
    int   max_out;
    int   simplex_max_iter;
    int   growth_iter;
    float score_converge;
    float trans_step;
    float rot_step;
    float tors_step;
    float ie_soft_delta;
    float ie_cutoff_sq;
    int   num_nb_pairs;
    int   det_seed;
    float pruning_score_cutoff;
    float cluster_rmsd;
    int   debug;
    int   glob_oid_base;
    int   anchor_total;
} pc;

// ---- reuse from simplex.comp ----
uint hash_u32(uint x){ x ^= x>>16; x*=0x7feb352du; x ^= x>>15; x*=0x846ca68bu; x ^= x>>16; return x; }
float rand11(uint s, uint i, uint j){ uint h = uint(pc.det_seed) ^ (i*0x9e3779b9u) ^ (j*1009u) ^ (s*2654435761u); if(h==0u) h=0x85ebca6bu+i*0x9e3779b9u+j; h=hash_u32(h); return float(h & 0x7fffffff)/1073741824.0 -1.0; }
float sample_grid(sampler3D g,float x,float y,float z){ float gx=(x-pc.origin_x)/pc.spacing, gy=(y-pc.origin_y)/pc.spacing, gz=(z-pc.origin_z)/pc.spacing; if(gx<0||gy<0||gz<0||gx>=float(pc.span_x-1)||gy>=float(pc.span_y-1)||gz>=float(pc.span_z-1)) return 0.0; vec3 c=vec3((gx+0.5)/float(pc.span_x),(gy+0.5)/float(pc.span_y),(gz+0.5)/float(pc.span_z)); return texture(g,c).r; }
void get_qmat(out mat3 m, vec3 qin){
    float q[3],q2[3],s2=0; for(int i=0;i<3;i++){ q[i]=qin[i]; if(q[i]>1) q[i]=mod(q[i]+1,2)-1; else if(q[i]<-1) q[i]=mod(q[i]-1,2)+1; q2[i]=q[i]*q[i]; s2+=q2[i];}
    float qn2,qn,qa[3]; for(int i=0;i<3;i++) qa[i]=q[i];
    if(s2<1){ qn2=1-s2; qn=sqrt(qn2);} else if(s2==1) qn=qn2=0; else { for(int i=0;i<3;i++) q2[i]/=s2; float s=sqrt(s2); for(int i=0;i<3;i++) qa[i]/=s; qn=qn2=0; for(int i=0;i<3;i++) q[i]=qa[i];}
    float t1=q[0]*q[1],t2=q[0]*q[2],t3=q[1]*q[2],qnq0=qn*q[0],qnq1=qn*q[1],qnq2=qn*q[2];
    float c00=qn2+q2[0]-q2[1]-q2[2],c01=2*(t1+qnq2),c02=2*(t2-qnq1),c10=2*(t1-qnq2),c11=qn2-q2[0]+q2[1]-q2[2],c12=2*(t3+qnq0),c20=2*(t2+qnq1),c21=2*(t3-qnq0),c22=qn2-q2[0]-q2[1]+q2[2];
    m[0][0]=c00; m[1][0]=c01; m[2][0]=c02; m[0][1]=c10; m[1][1]=c11; m[2][1]=c12; m[0][2]=c20; m[1][2]=c21; m[2][2]=c22;
}
int is_active(int tstep, int a){ return actset[tstep*pc.num_atoms + a]; }
float score_pose(int base, int tstep, int na){
    float s=0;
    for(int a=0;a<na;a++){ if(is_active(tstep,a)==0) continue;
        float x=scratch[base+a*3],y=scratch[base+a*3+1],z=scratch[base+a*3+2];
        s+=vdwA[a]*sample_grid(g_avdw,x,y,z)-vdwB[a]*sample_grid(g_bvdw,x,y,z)+charges[a]*sample_grid(g_es,x,y,z);
        int s0=pair_starts[a], s1=(a+1<na)?pair_starts[a+1]:pc.num_nb_pairs;
        for(int pi=s0;pi<s1;pi++){ int a2=pair_indices[pi]; if(a2<0||a2>=na||is_active(tstep,a2)==0) continue;
            float x2=scratch[base+a2*3],y2=scratch[base+a2*3+1],z2=scratch[base+a2*3+2];
            float dx=x-x2,dy=y-y2,dz=z-z2,r2=dx*dx+dy*dy+dz*dz; if(r2>pc.ie_cutoff_sq) continue;
            float r2d=r2+pc.ie_soft_delta,r6=r2d*r2d*r2d,r12=r6*r6; s+=ie_vdwA[a]*ie_vdwA[a2]/r12; } }
    return s;
}
/* Rotate this bond's rotor set by rotang_rad about the (a2-a3) axis,
 * using the CPU set_torsion geometry (axis = normalize(a2-a3), rotor =
 * tors_mask row, rotation point = a2).  a1..a4 are in CPU CALL order. */
void rotmat_rotor(int t, float rotang, int base, int na){
    int a2=tors_a1234[t*5+1], a3=tors_a1234[t*5+2];
    float v2x=scratch[base+a2*3]-scratch[base+a3*3],v2y=scratch[base+a2*3+1]-scratch[base+a3*3+1],v2z=scratch[base+a2*3+2]-scratch[base+a3*3+2];
    float mag=sqrt(v2x*v2x+v2y*v2y+v2z*v2z);
    if(mag<1e-6) return;
    float sn=sin(rotang), cs=cos(rotang), tcs=1.0-cs;
    float nx=v2x/mag, ny=v2y/mag, nz=v2z/mag;
    float m0=tcs*nx*nx+cs,    m1=tcs*nx*ny+sn*nz,  m2=tcs*nx*nz-sn*ny;
    float m3=tcs*nx*ny-sn*nz, m4=tcs*ny*ny+cs,     m5=tcs*ny*nz+sn*nx;
    float m6=tcs*nx*nz+sn*ny, m7=tcs*ny*nz-sn*nx,  m8=tcs*nz*nz+cs;
    float tx=scratch[base+a2*3],ty=scratch[base+a2*3+1],tz=scratch[base+a2*3+2];
    int mrow=t*pc.num_atoms;
    for(int a=0;a<na;a++) if(tors_mask[mrow+a]!=0){
        float dx=scratch[base+a*3]-tx,dy=scratch[base+a*3+1]-ty,dz=scratch[base+a*3+2]-tz;
        scratch[base+a*3]  = m0*dx+m1*dy+m2*dz+tx;
        scratch[base+a*3+1]= m3*dx+m4*dy+m5*dz+ty;
        scratch[base+a*3+2]= m6*dx+m7*dy+m8*dz+tz; }
}
/* Measure current dihedral a1..a4 (DOCK radang convention). */
float dihedral_radang(int t, int base, int na){
    int a1=tors_a1234[t*5+0], a2=tors_a1234[t*5+1], a3=tors_a1234[t*5+2], a4=tors_a1234[t*5+3];
    float v1x=scratch[base+a1*3]-scratch[base+a2*3],v1y=scratch[base+a1*3+1]-scratch[base+a2*3+1],v1z=scratch[base+a1*3+2]-scratch[base+a2*3+2];
    float v2x=scratch[base+a2*3]-scratch[base+a3*3],v2y=scratch[base+a2*3+1]-scratch[base+a3*3+1],v2z=scratch[base+a2*3+2]-scratch[base+a3*3+2];
    float v3x=scratch[base+a3*3]-scratch[base+a4*3],v3y=scratch[base+a3*3+1]-scratch[base+a4*3+1],v3z=scratch[base+a3*3+2]-scratch[base+a4*3+2];
    float c1x=v1y*v2z-v1z*v2y,c1y=-v1x*v2z+v1z*v2x,c1z=v1x*v2y-v1y*v2x;
    float c2x=v2y*v3z-v2z*v3y,c2y=-v2x*v3z+v2z*v3x,c2z=v2x*v3y-v2y*v3x;
    float c3x=c1y*c2z-c1z*c2y,c3y=-c1x*c2z+c1z*c2x,c3z=c1x*c2y-c1y*c2x;
    float c1mag=c1x*c1x+c1y*c1y+c1z*c1z, c2mag=c2x*c2x+c2y*c2y+c2z*c2z;
    float costheta=1.0;
    if(c1mag*c2mag > 1.0e-6) costheta=(c1x*c2x+c1y*c2y+c1z*c2z)/sqrt(c1mag*c2mag);
    if(costheta < -0.999999) costheta=-0.999999;
    if(costheta >  0.999999) costheta= 0.999999;
    float radang = acos(costheta);
    if((v2x*c3x+v2y*c3y+v2z*c3z) > 0.0) radang = -radang;
    return radang;
}
/* Absolute drive (CPU set_torsion semantics): rotate so the dihedral
 * becomes target_deg.  Used for sampling each DB angle around the frontier. */
void apply_torsion_abs(int t, float target_deg, int base, int na){
    float rotang = target_deg*3.14159265/180.0 - dihedral_radang(t, base, na);
    rotmat_rotor(t, rotang, base, na);
}
/* Relative perturbation (minimizer semantics): rotate the rotor by delta_deg
 * about the bond, preserving the current dihedral at delta=0. */
void apply_torsion_delta(int t, float delta_deg, int base, int na){
    rotmat_rotor(t, delta_deg*3.14159265/180.0, base, na);
}
/* Relative-DOF transform applied to a pose slot (in place).
   vo is an offset into the simplex SSBO holding this 32-float vertex. */
void apply_dof(int vo, int ndim, int base, int tstep, int na){
    vec3 q=vec3(simp[vo+3]*pc.rot_step, simp[vo+4]*pc.rot_step, simp[vo+5]*pc.rot_step);
    mat3 R; get_qmat(R,q);
    float comx=0,comy=0,comz=0; int cnt=0;
    for(int a=0;a<na;a++) if(is_active(tstep,a)!=0){ comx+=scratch[base+a*3]; comy+=scratch[base+a*3+1]; comz+=scratch[base+a*3+2]; cnt++; }
    if(cnt>0){ comx/=float(cnt); comy/=float(cnt); comz/=float(cnt); }
    float dvx=simp[vo]*pc.trans_step,dvy=simp[vo+1]*pc.trans_step,dvz=simp[vo+2]*pc.trans_step;
    for(int a=0;a<na;a++){
        float tx=scratch[base+a*3]-comx,ty=scratch[base+a*3+1]-comy,tz=scratch[base+a*3+2]-comz;
        scratch[base+a*3]=R[0][0]*tx+R[0][1]*ty+R[0][2]*tz+comx+dvx;
        scratch[base+a*3+1]=R[1][0]*tx+R[1][1]*ty+R[1][2]*tz+comy+dvy;
        scratch[base+a*3+2]=R[2][0]*tx+R[2][1]*ty+R[2][2]*tz+comz+dvz;
    }
    for(int t=0;t<tstep;t++){ float dv=simp[vo+6+t]; if(abs(dv)<1e-6) continue; apply_torsion_delta(t, dv*pc.tors_step, base, na); }
}
/* Rebuild ws from pristine, apply vertex, return score. vo = SSBO offset. */
float eval_vertex(int vo, int ndim, int pristine, int ws, int tstep, int na){
    for(int c=0;c<na*3;c++) scratch[ws+c]=scratch[pristine+c];
    apply_dof(vo, ndim, ws, tstep, na);
    return score_pose(ws, tstep, na);
}
/* Nelder-Mead in pose space. Pristine holds the (unchanged) starting pose;
 * best pose is written back to pristine via ws. Returns best score.
 * All working state lives in the simplex SSBO: this keeps per-invocation
 * private storage constant instead of scaling with ndim. */
float minimize_in_pose(int na,int ndim,int pristine,int ws,int tstep,int orient_id){
    if(ndim<=0||ndim>32) return 1e30;
    int sbase = int(gl_LocalInvocationID.x) * SIMPLEX_VSTRIDE;
    int P0  = sbase;               /* vertices: 33 x 32 floats  */
    int Y0  = P0 + 1056;           /* vertex scores: 33 floats  */
    int PB0 = Y0 + 33;             /* centroid: 32 floats       */
    int PR0 = PB0 + 32;            /* reflected: 32 floats      */
    int C0  = PR0 + 32;            /* exp/A/B: 3 x 32 floats    */
    for(int j=0;j<ndim;j++) simp[P0+j]=0;
    for(int i=1;i<ndim+1;i++) for(int j=0;j<ndim;j++) simp[P0+i*32+j]=rand11(uint(orient_id),uint(i),uint(j));
    for(int i=0;i<ndim+1;i++) simp[Y0+i]=eval_vertex(P0+i*32,ndim,pristine,ws,tstep,na);
    int ilo=0,ihi=0,inhi=0; if(simp[Y0]>simp[Y0+1]){ihi=0;inhi=1;}else{ihi=1;inhi=0;} for(int i=0;i<ndim+1;i++){ if(simp[Y0+i]<simp[Y0+ilo]) ilo=i; if(simp[Y0+i]>simp[Y0+ihi]){inhi=ihi;ihi=i;} else if(simp[Y0+i]>simp[Y0+inhi]&&i!=ihi) inhi=i; }
    const float alpha=1,gamma=2,beta=0.5,sigma=0.5;
    int maxiter = (tstep>0) ? pc.growth_iter : pc.simplex_max_iter;
    if (maxiter < 1) maxiter = 1;
    for(int iter=0;iter<maxiter;iter++){
        if(abs(simp[Y0+ihi]-simp[Y0+ilo])<=pc.score_converge) break;
        int vi = P0 + ihi*32;
        for(int j=0;j<ndim;j++) simp[PB0+j]=0; for(int i=0;i<ndim+1;i++) if(i!=ihi) for(int j=0;j<ndim;j++) simp[PB0+j]+=simp[P0+i*32+j]; for(int j=0;j<ndim;j++){ simp[PB0+j]/=float(ndim); simp[PR0+j]=(1+alpha)*simp[PB0+j]-alpha*simp[vi+j]; }
        for(int j=0;j<ndim;j++){ simp[C0+j]=gamma*simp[PR0+j]+(1-gamma)*simp[PB0+j]; simp[C0+32+j]=beta*simp[PR0+j]+(1-beta)*simp[PB0+j]; simp[C0+64+j]=beta*simp[vi+j]+(1-beta)*simp[PB0+j]; }
        float ypr=eval_vertex(PR0,ndim,pristine,ws,tstep,na);
        float yexp=eval_vertex(C0,ndim,pristine,ws,tstep,na);
        float yA=eval_vertex(C0+32,ndim,pristine,ws,tstep,na);
        float yB=eval_vertex(C0+64,ndim,pristine,ws,tstep,na);
        bool rep=false;
        if(ypr<=simp[Y0+ilo]){ if(yexp<simp[Y0+ilo]){ for(int j=0;j<ndim;j++) simp[vi+j]=simp[C0+j]; simp[Y0+ihi]=yexp;} else{ for(int j=0;j<ndim;j++) simp[vi+j]=simp[PR0+j]; simp[Y0+ihi]=ypr;} rep=true; }
        else if(ypr>=simp[Y0+inhi]){
            if(ypr<simp[Y0+ihi]){ for(int j=0;j<ndim;j++) simp[vi+j]=simp[PR0+j]; simp[Y0+ihi]=ypr; rep=true;}
            if(ypr<simp[Y0+ihi]){
                if(yA<simp[Y0+ihi]){ for(int j=0;j<ndim;j++) simp[vi+j]=simp[C0+32+j]; simp[Y0+ihi]=yA; rep=true; }
            } else {
                if(yB<simp[Y0+ihi]){ for(int j=0;j<ndim;j++) simp[vi+j]=simp[C0+64+j]; simp[Y0+ihi]=yB; rep=true; }
            }
            if(!rep){ for(int i=0;i<ndim+1;i++) if(i!=ilo) for(int j=0;j<ndim;j++) simp[P0+i*32+j]=sigma*simp[P0+i*32+j]+(1-sigma)*simp[P0+ilo*32+j]; for(int i=0;i<ndim+1;i++) if(i!=ilo){ simp[Y0+i]=eval_vertex(P0+i*32,ndim,pristine,ws,tstep,na);} }
        }
        else{ for(int j=0;j<ndim;j++) simp[vi+j]=simp[PR0+j]; simp[Y0+ihi]=ypr; rep=true; }
        ilo=0; if(simp[Y0]>simp[Y0+1]){ihi=0;inhi=1;}else{ihi=1;inhi=0;} for(int i=0;i<ndim+1;i++){ if(simp[Y0+i]<simp[Y0+ilo]) ilo=i; if(simp[Y0+i]>simp[Y0+ihi]){inhi=ihi;ihi=i;} else if(simp[Y0+i]>simp[Y0+inhi]&&i!=ihi) inhi=i; }
    }
    int besti=0; float bs=1e30; for(int i=0;i<ndim+1;i++) if(simp[Y0+i]<bs){bs=simp[Y0+i];besti=i;}
    eval_vertex(P0+besti*32,ndim,pristine,ws,tstep,na);
    for(int c=0;c<na*3;c++) scratch[pristine+c]=scratch[ws+c];
    return bs;
}
void main(){
    uint oid = gl_WorkGroupID.x;
    if(oid >= uint(pc.num_orients)) return;
    if(gl_LocalInvocationID.x != 0) return;
    int na = pc.num_atoms;
    int goid = int(oid) + pc.glob_oid_base;
    int F = goid*SLOTS*na*3;
    int ws = F;
    int prist = F + na*3;
    int fr[SLOTS]; float fs[SLOTS];
    int nfront = 0;
    if(pc.debug!=0){
        int dbgbase = pc.anchor_total*SLOTS*na*3 + goid*16;
        scratch[dbgbase+11]=-99.0f; /* alive marker */
    }
    // ---------- anchor stage ----------
    int src = goid*na*3;
    for(int c=0;c<na*3;c++) scratch[prist+c]=orient_xyz[src+c];
    float s0 = minimize_in_pose(na, 6, prist, ws, 0, int(goid)^0x51ab3);
    if (goid < pc.max_out) out_scores[goid] = s0;   /* debug: anchor score channel */
    fr[0]=prist; fs[0]=s0; nfront=1;
    // ---------- growth ----------
    int dbgstage[8]; for(int di=0;di<8;di++) dbgstage[di]=-1;
    float bestacc=1e30, worstacc=-1e30; int totalcand=0;
    for(int t=0;t<pc.num_tors;t++){
        int nang = tors_a1234[t*5+4]; if(nang<1) nang=1; if(nang>MAXDB) nang=MAXDB;
        int tstep = t+1;
        int newn = 0;
        totalcand += nfront*nang;
        for(int p=0;p<nfront;p++){
            for(int k=0;k<nang;k++){
                for(int c=0;c<na*3;c++) scratch[prist+c]=scratch[fr[p]+c];
                apply_torsion_abs(t, ang_db[t*MAXDB+k], prist, na);
                float s = minimize_in_pose(na, 6+tstep, prist, ws, tstep, int((oid<<8u)^uint(t*4+k))^0x5eed);
                if(s > pc.pruning_score_cutoff) continue;
                if(s<bestacc) bestacc=s; if(s>worstacc) worstacc=s;
                if(newn < SLOTS-2){ fr[1+newn]=F+(2+newn)*na*3; for(int c=0;c<na*3;c++) scratch[fr[1+newn]+c]=scratch[prist+c]; fs[newn]=s; newn++; }
                // No KEEP limit - retain all that pass pruning (up to SLOTS-2 per WG per stage)
            }
        }
        nfront = newn;
        if(t<8) dbgstage[t]=nfront;
        if(pc.debug!=0){
            int dbgbase = pc.anchor_total*SLOTS*na*3 + goid*16;
            for(int di=0;di<8;di++) scratch[dbgbase+di]=float(dbgstage[di]);
            scratch[dbgbase+8]=bestacc; scratch[dbgbase+9]=worstacc; scratch[dbgbase+10]=float(totalcand);
            scratch[dbgbase+12]=float(t);
        }
        if(nfront==0) return;
    }
    // ---------- output ----------
    for(int p=0;p<nfront;p++){
        uint idx = atomicAdd(out_counter[0], 1);
        if(idx >= uint(pc.max_out)){ atomicAdd(out_counter[0], uint(0)-1); return; }
        int dst = int(idx)*na*3;
        for(int c=0;c<na*3;c++) out_xyz[dst+c]=scratch[fr[p]+c];
        out_scores[idx]=fs[p];
    }
}