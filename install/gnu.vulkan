# DOCK configuration: GNU compilers + Vulkan backend.
#
# Build with:
#   cd install && ./configure gnu.vulkan
#   cd ../src/dock && make clean && make -j$(nproc)
#   (or simply: cd ../src && make install)
#
# Produces dock6.gnu.vulkan in src/dock and installs it (plus shaders/*.comp)
# into ../../bin.

CC=          gcc
CFLAGS=      -O3 -fno-signed-zeros -fno-trapping-math -march=native -mtune=native -funroll-loops -std=gnu17
CXX=         g++
CXXFLAGS=    -O3 -fno-signed-zeros -fno-trapping-math -march=native -mtune=native -funroll-loops -std=c++11
DOCK_SUFFIX= .gnu.vulkan
FC=          gfortran
FFLAGS=      -O3 -fno-automatic -fno-second-underscore -std=legacy -march=native -mtune=native
LIBS=        -lm -lpthread
LINK_WITHOUT_FORTRAN_MAIN=
LOAD=        g++

# GPU backend selection: gnu.vulkan -> Vulkan (portable, Steam Deck).
# This is read by src/dock/Makefile and src/grid/Makefile.
# Corresponds to the USE_VULKAN build branch (-lvulkan -lshaderc).
GPU_BACKEND= vulkan

# Macro definitions for NAB
# AR is the library archiver
# LEX is the lexical analyzer generator; the darwin and xopen defines are
# workarounds for some macOS 12 header file issues; e.g.:
# sff.c:1615:19: error: implicitly declaring library function 'strdup' with type 'char *(const char *)
# see also https://github.com/gphoto/libgphoto2/issues/552
# OCFLAGS is the flags for the C compilers with high optimization
# RANLIB is the library index generator
AR=          ar rv
LEX=         flex -D_DARWIN_C_SOURCE -D_XOPEN_SOURCE=600
OCFLAGS=     -O3 -std=gnu17 -D_ANSI_SOURCE
RANLIB=      ranlib
