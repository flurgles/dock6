# DOCK configuration file for Apple Clang compilers on macOS (GPU enabled).
# Tested on Apple Silicon (arm64) with Apple Clang 21.0.0 and
# Homebrew GCC 16.1.0 for Fortran.
#
# The main dock6 executable links NO Fortran code; Fortran is only
# used for utility programs (make utils).  This config uses clang++
# as both the C++ compiler and the linker, which avoids ABI
# mismatches and eliminates the need for -Wl,-ld_classic.
#
# GPU/Metal enabled: the Makefile links -framework Metal automatically
# for GPU-accelerated scoring and simplex minimization.
# Produces dock6.clang.gpu as the executable.
#
# NOTE: Do NOT add -flto to CFLAGS/CXXFLAGS — it strips Metal/Objective-C
# symbols at link time, causing GPU initialization failure.  The
# Makefile already filters -flto from .mm compilation, but LTO at the
# link step still kills the Metal symbols.

# CC is the C compiler
# CFLAGS is the flags for the C compiler
# CXX is the C++ compiler
# CXXFLAGS is the flags for the C++ compiler
# DOCK_SUFFIX is the suffix for the dock executable
# FC is the Fortran compiler
# FFLAGS is the flags for the Fortran compiler
# LIBS is the flags for the linker
# LINK_WITHOUT_FORTRAN_MAIN is the flag for linking without Fortran's main
# LOAD is the command to invoke the linker

CC=          clang
CFLAGS=      -O3 -pipe -std=c99 -D_DARWIN_C_SOURCE -mcpu=native -ffast-math
CXX=         clang++
CXXFLAGS=    -O3 -pipe -std=c++11 -mcpu=native -ffast-math
DOCK_SUFFIX= .clang.gpu
FC=          gfortran
FFLAGS=      -O2 -fno-automatic -fno-second-underscore -std=legacy
LIBS=        -lm -lpthread
LINK_WITHOUT_FORTRAN_MAIN=
LOAD=        clang++

# Macro definitions for NAB
# AR is the library archiver
# LEX is the lexical analyzer generator; the darwin and xopen defines are
# workarounds for some macOS header file issues; e.g.:
# sff.c:1615:19: error: implicitly declaring library function 'strdup'
# see also https://github.com/gphoto/libgphoto2/issues/552
# OCFLAGS is the flags for the C compilers with high optimization
# RANLIB is the library index generator
AR=          ar rv
LEX=         flex -D_DARWIN_C_SOURCE -D_XOPEN_SOURCE=600
OCFLAGS=     -O3 -pipe -D_DARWIN_C_SOURCE -mcpu=native -ffast-math
RANLIB=      ranlib

# YACC for tleap parser generation
YACC=        /opt/homebrew/opt/bison/bin/bison --yacc
